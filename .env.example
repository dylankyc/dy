# Credentials for the AI gateway. Copy to `.env` and fill in what you have — every provider is
# optional, and a missing key only disables the aliases backed by it.
#
#   cp .env.example .env && $EDITOR .env && ./quickstart.sh
#
# quickstart.sh writes this file for you if you already keep keys in your environment,
# in ~/.secret/*, or in ~/.aws/credentials — so you usually never touch it by hand.

# OpenAI — aliases: fast, gpt-4o, gpt-4o-mini, gpt-5, gpt-5.1, gpt-5.1-codex …
OPENAI_API_KEY=

# Anthropic — alias: claude (primary leg of the claude failover pool)
ANTHROPIC_API_KEY=

# Google Gemini — alias: gemini
GEMINI_API_KEY=

# Azure OpenAI — alias: azure. The key is useless without the resource endpoint, and `wire_id`
# in gateway.config.yml must be your *deployment* name.
# AZURE_API_KEY=
# AZURE_ENDPOINT=https://<your-resource>.openai.azure.com

# AWS Bedrock — aliases: bedrock-claude, and the failover leg of claude.
# The gateway signs SigV4 itself, so it needs the keys, not a profile name.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
#
# Leave AWS_SESSION_TOKEN out entirely unless you use STS: an *empty* value is signed into the
# request as a blank x-amz-security-token and Bedrock answers 403.
# AWS_SESSION_TOKEN=
