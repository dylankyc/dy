# Credentials for the gateway. Copy to `.env` and fill in what you have — every provider is
# optional, and a missing key only disables the aliases backed by it.
#
#   cp .env.example .env && $EDITOR .env && ./quickstart.sh
#
# quickstart.sh writes this file for you if you already keep keys in your environment,
# in ~/.secret/*, or in ~/.aws/credentials — so you usually never touch it by hand.

# OpenAI — aliases: fast, gpt-4o, gpt-4o-mini, gpt-5, gpt-5.1, gpt-5.1-codex, codex …
OPENAI_API_KEY=

# Anthropic — alias: claude (primary leg of the claude failover pool)
ANTHROPIC_API_KEY=

# Google Gemini — alias: gemini
GEMINI_API_KEY=

# Azure OpenAI — alias: azure. Endpoint/deployment/region are literals in gateway.config.yml
# (no env-var indirection for those fields) — edit the file directly if yours differ.
# AZURE_API_KEY=

# Azure AI Foundry (Claude on Azure, Anthropic Messages protocol) — alias: azure-claude
# AZURE_FOUNDRY_API_KEY=

# AWS Bedrock (SigV4) — aliases: bedrock-claude, and the failover leg of claude.
# The gateway signs SigV4 itself, so it needs the keys, not a profile name.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
#
# Leave AWS_SESSION_TOKEN out entirely unless you use STS: an *empty* value is signed into the
# request as a blank x-amz-security-token and Bedrock answers 403.
# AWS_SESSION_TOKEN=

# AWS Bedrock Mantle (OpenAI's own models on AWS, Responses API only) — alias: codex.
# A Bedrock API key sent as a Bearer — region-scoped and short-lived; re-mint and re-run when it
# expires.
# AWS_BEARER_TOKEN_BEDROCK=

# Google Vertex AI (Claude on GCP) — aliases: vertex-claude, vertex-sonnet-4-5. A GCP OAuth
# Bearer, ~1h lifetime — quickstart.sh mints it from `gcloud auth print-access-token`
# automatically if gcloud is installed and logged in; set it directly only if you mint it some
# other way.
# VERTEX_ACCESS_TOKEN=
